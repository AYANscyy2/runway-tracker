# Copy this file to .env.local and fill in your own Postgres connection string.
# Free options that work fine: Neon (neon.tech), Supabase, or Railway.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Better Auth Configuration
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Comma-separated Google account emails allowed to sign in. Everyone else is
# rejected at sign-up.
ALLOWED_EMAILS=you@example.com,friend@example.com

# Public URL of the deployed site (custom domain). Used for metadata / OG
# images and added to the auth trusted origins. Optional in dev.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
